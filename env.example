# CofC Soccer Analytics — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your_key_here

# ── Streamlit Dashboard ───────────────────────────────────────
STREAMLIT_PASSWORD=your_staff_password_here

# ── Pipeline path overrides (optional) ────────────────────────
# Leave these blank/commented on a normal clone. Set only if your data lives
# outside the repo, such as a mounted Google Drive folder.
# COFC_REPO_ROOT=/path/to/cofc_soccer_analytics_2026
# COFC_PIPELINE_ROOT=/path/to/cofc_soccer_analytics_2026/pipeline
# COFC_MATCHES_DIR=/path/to/data/matches
# COFC_RAW_DIR=/path/to/data/raw
# COFC_WYSCOUT_PDF_DIR=/path/to/data/raw/player_reports
# COFC_PARSED_OUTPUTS_DIR=/path/to/pipeline/outputs
# COFC_LEGACY_DATA_OUTPUTS_DIR=/path/to/pipeline/data/outputs
# COFC_MATCHES_MANIFEST=/path/to/pipeline/data/manifests/matches_manifest.csv
# COFC_REPORTS_DIR=/path/to/pipeline/outputs/reports
# COFC_ROSTER_PATH=/path/to/pipeline/ingestion/roster_2025.csv
# COFC_SPIIDEO_DIR=/path/to/data/raw/spiideo

# ── Optional: AI Queries (Tab 3 — requires Anthropic API key) ─
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── FastAPI ───────────────────────────────────────────────────
# VITE_API_URL=http://localhost:8000   ← set in frontend/.env
