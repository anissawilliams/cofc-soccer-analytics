# CofC Soccer Analytics — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your_key_here

# ── Streamlit Dashboard ───────────────────────────────────────
STREAMLIT_PASSWORD=your_staff_password_here

# ── Pipeline (if running ingestion from this repo) ────────────
PIPELINE_ROOT=/path/to/your/pipeline/folder

# ── Optional: AI Queries (Tab 3 — requires Anthropic API key) ─
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── FastAPI ───────────────────────────────────────────────────
# VITE_API_URL=http://localhost:8000   ← set in frontend/.env
